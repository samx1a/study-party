# Postgres connection string (Supabase, Neon, or local)
DATABASE_URL=postgres://localhost:5432/study_party

# Better Auth: a long random string (run: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The public URL of the app
BETTER_AUTH_URL=http://localhost:3000

# LiveKit. For local dev run `npm run livekit` (uses devkey/secret).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Server-side URL used for the room service API (http/https)
LIVEKIT_URL=http://localhost:7880
# Browser-side URL for media (ws/wss)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
